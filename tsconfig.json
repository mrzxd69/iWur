{
	"compilerOptions": {
		"lib": [
			"ESNext",
			"DOM"
		],
		"target": "ESNext",
		"module": "ESNext",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"allowJs": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"types": [
			"bun-plugin-glob-import/types"
		],
		"noPropertyAccessFromIndexSignature": false,
		"paths": {
			"@db/*": [
				"./src/db/*"
			],
			"@typescript/*": [
				"./src/types/*"
			],
			"@bot/*": [
				"./src/bot/*"
			],
			"@keyboards/*": [
				"./src/bot/keyboards/*"
			],
			"@src/*": [
				"./src/*"
			],
			"@xlsx/*": [
				"./src/xlsx/*"
			],
			"@services/*": [
				"./src/services/*"
			]
		}
	}
}